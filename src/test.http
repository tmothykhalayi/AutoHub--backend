###############################################
# 5. BOOKINGS MODULE
###############################################

### 5.1 Create new booking
POST {{baseUrl}}/bookings
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "vehicleId": 1,
  "startDate": "2025-05-15T09:00:00Z",
  "endDate": "2025-05-20T18:00:00Z",
  "pickupLocation": "Main Branch - Manhattan Downtown",
  "dropoffLocation": "Main Branch - Manhattan Downtown"
}

###

### 5.2 Get all bookings (paginated)
GET {{baseUrl}}/bookings?page=1&limit=10
Authorization: Bearer {{accessToken}}

###

### 5.3 Get all bookings
GET {{baseUrl}}/bookings
Authorization: Bearer {{accessToken}}

###

### 5.4 Get my bookings
GET {{baseUrl}}/bookings/my-bookings
Authorization: Bearer {{accessToken}}

###

### 5.5 Get active bookings
GET {{baseUrl}}/bookings/active
Authorization: Bearer {{accessToken}}

###

### 5.6 Get upcoming bookings
GET {{baseUrl}}/bookings/upcoming
Authorization: Bearer {{accessToken}}

###

### 5.7 Get booking statistics
GET {{baseUrl}}/bookings/stats
Authorization: Bearer {{accessToken}}

###

### 5.8 Get bookings by vehicle
GET {{baseUrl}}/bookings/vehicle/{{vehicleId}}
Authorization: Bearer {{accessToken}}

###

### 5.9 Get booking by ID
GET {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{accessToken}}

###

### 5.10 Check vehicle availability
GET {{baseUrl}}/bookings/availability/{{vehicleId}}?startDate=2025-05-15&endDate=2025-05-20
Authorization: Bearer {{accessToken}}

###

### 5.11 Update booking
PATCH {{baseUrl}}/bookings/{{bookingId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "startDate": "2025-05-15T10:00:00Z",
  "endDate": "2025-05-21T18:00:00Z",
  "additionalNotes": "Updated notes"
}

###

### 5.12 Cancel booking
PATCH {{baseUrl}}/bookings/{{bookingId}}/cancel
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "reason": "Personal emergency"
}

###

### 5.13 Delete booking (admin only)
DELETE {{baseUrl}}/bookings/{{bookingId}}
Authorization: Bearer {{accessToken}}

###

###############################################
# 6. PAYMENTS MODULE
###############################################

### 6.1 Initialize payment (Paystack)
POST {{baseUrl}}/payments/initialize
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "bookingId": 1,
  "email": "user@example.com",
  "amount": 750.50,
  "currency": "NGN",
  "paymentMethod": "paystack"
}

###

### 6.2 Verify payment
POST {{baseUrl}}/payments/verify/{{reference}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

###

### 6.3 Get all payments (user's)
GET {{baseUrl}}/payments
Authorization: Bearer {{accessToken}}

###

### 6.4 Get all payments (admin only)
GET {{baseUrl}}/payments/admin/all
Authorization: Bearer {{accessToken}}

###

### 6.5 Get payments by branch (admin)
GET {{baseUrl}}/payments/branch/{{branchId}}
Authorization: Bearer {{accessToken}}

###

### 6.6 Get payment by ID
GET {{baseUrl}}/payments/{{paymentId}}
Authorization: Bearer {{accessToken}}

###

### 6.7 Update payment status (admin only)
PATCH {{baseUrl}}/payments/{{paymentId}}/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "status": "completed"
}

###

### 6.8 Process refund
POST {{baseUrl}}/payments/{{paymentId}}/refund
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "amount": 350.25,
  "reason": "Booking cancelled - customer requested"
}

###

### 6.9 Cancel payment (admin only)
PATCH {{baseUrl}}/payments/{{paymentId}}/cancel
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "reason": "Customer cancelled booking"
}

###

### 6.10 Update payment details (admin)
PATCH {{baseUrl}}/payments/{{paymentId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "status": "pending",
  "notes": "Awaiting confirmation from customer"
}

###

### 6.11 Delete payment (admin only)
DELETE {{baseUrl}}/payments/{{paymentId}}
Authorization: Bearer {{accessToken}}

###

### 6.12 Webhook - Payment notification
POST {{baseUrl}}/payments/webhook
Content-Type: application/json

{
  "event": "charge.success",
  "data": {
    "reference": "payment_reference_123",
    "amount": 75000,
    "status": "success"
  }
}

###

