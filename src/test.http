
###############################################
# AutoHub Backend - Complete Test Suite
# Base URL: http://localhost:3001
# Last Updated: 2025-04-27
###############################################

@baseUrl = http://localhost:8000
@accessToken = your-access-token-here
@refreshToken = your-refresh-token-here
@userId = 1
@vehicleId = 1
@bookingId = 1
@paymentId = 1
@branchId = 1
@vehicleSpecId = 1
@fleetManagementId = 1
@supportTicketId = 1

###############################################
# 1. AUTHENTICATION ENDPOINTS
###############################################

### 1.1 Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "Test1234!",
  "firstName": "John",
  "lastName": "Doe",
  "phoneNumber": "+12345678901",
  "role": "customer"
}

###

### 1.2 Login user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "Test1234!"
}

###

### 1.3 Refresh access token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json
Authorization: Bearer {{refreshToken}}

{}

###

### 1.4 Forgot password (request reset token)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "newuser@example.com"
}

###

### 1.5 Reset password (with token from email)
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "token": "your-reset-token-here",
  "newPassword": "NewPassword1234!"
}

###

### 1.6 Sign out user
POST {{baseUrl}}/auth/signout
Authorization: Bearer {{accessToken}}

###

###############################################
# 2. USERS MODULE
###############################################

### 2.1 Create a new user (admin only)
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "email": "admin@example.com",
  "password": "AdminPass1234!",
  "firstName": "Admin",
  "lastName": "User",
  "role": "admin" ,
  "phoneNumber": "+1234567890"
}

###

### 2.2 Get all users (admin only)
GET {{baseUrl}}/users
Authorization: Bearer {{accessToken}}

###

### 2.3 Get user by ID
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}

###

### 2.4 Update user profile
PATCH {{baseUrl}}/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "firstName": "UpdatedFirst",
  "lastName": "UpdatedLast",
  "phoneNumber": "+19876543210"
}

###

### 2.5 Delete user (admin only)
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{accessToken}}

###

###############################################
# 3. VEHICLES MODULE
###############################################

### 3.1 Create new vehicle (admin only)
POST {{baseUrl}}/vehicle
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "licensePlate": "ABC123XYZ",
  "make": "Toyota",
  "model": "Camry",
  "year": 2023,
  "color": "Silver",
  "fuelType": "hybrid",
  "transmission": "automatic",
  "seatingCapacity": 5,
  "mileage": 15000,
  "fuelLevel": 75,
  "status": "available",
  "dailyRate": 75.00,
  "weeklyRate": 450.00,
  "monthlyRate": 1800.00,
  "specId": 1,
  "branchId": 1
}

###

### 3.2 Get all vehicles (with filters)
GET {{baseUrl}}/vehicle?status=available&make=Toyota&page=1&limit=10
Authorization: Bearer {{accessToken}}

###

### 3.3 Get all vehicles without filter
GET {{baseUrl}}/vehicle
Authorization: Bearer {{accessToken}}

###

### 3.4 Get vehicle by ID
GET {{baseUrl}}/vehicle/{{vehicleId}}
Authorization: Bearer {{accessToken}}

###

### 3.5 Update vehicle (admin only)
PATCH {{baseUrl}}/vehicle/{{vehicleId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "mileage": 20000,
  "fuelLevel": 50,
  "status": "maintenance",
  "dailyRate": 85.00
}

###

### 3.6 Delete vehicle (admin only)
DELETE {{baseUrl}}/vehicle/{{vehicleId}}
Authorization: Bearer {{accessToken}}

###

###############################################
# 4. VEHICLE SPECIFICATIONS MODULE
###############################################

### 4.1 Create vehicle specification (admin only)
POST {{baseUrl}}/vehicle-specs
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "make": "BMW",
  "model": "3 Series",
  "year": 2024,
  "fuelType": "gasoline",
  "transmission": "automatic",
  "seatingCapacity": 5,
  "engineSize": 2.0,
  "horsepower": 255,
  "torque": 295,
  "acceleration": 6.2,
  "topSpeed": 250,
  "fuelConsumption": 8.5,
  "wheelSize": 18,
  "trunkCapacity": 460,
  "weight": 1600,
  "dimensions": "4.7m x 1.8m x 1.4m",
  "features": ["Leather Seats", "GPS", "Bluetooth", "Backup Camera"],
  "description": "Premium sedan with advanced features"
}

###

### 4.2 Get all vehicle specifications
GET {{baseUrl}}/vehicle-specs
Authorization: Bearer {{accessToken}}

###

### 4.3 Get vehicle specification by ID
GET {{baseUrl}}/vehicle-specs/{{vehicleSpecId}}
Authorization: Bearer {{accessToken}}

###

### 4.4 Update vehicle specification (admin only)
PATCH {{baseUrl}}/vehicle-specs/{{vehicleSpecId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "horsepower": 260,
  "topSpeed": 255,
  "features": ["Leather Seats", "GPS", "Bluetooth", "Backup Camera", "Heated Seats"]
}

###

### 4.5 Delete vehicle specification (admin only)
DELETE {{baseUrl}}/vehicle-specs/{{vehicleSpecId}}
Authorization: Bearer {{accessToken}}

