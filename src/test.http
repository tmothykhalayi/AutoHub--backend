
### Register a new test user for login testing
# @name register
POST http://localhost:8000/auth/register
Content-Type: application/json

{
  "email": "logintest1@example.com",
  "firstName": "Login",
  "lastName": "Test",
  "phoneNumber": "1234567890",
  "password": "Password123",
  "role": "customer"
}

### Login with newly registered user - CORRECT PASSWORD
# @name login
POST http://localhost:8000/auth/login
Content-Type: application/json

{
  "email": "logintes3t@example.com",
  "password": "Password123"
}

### Login with INCORRECT password (for testing error handling)
# @name loginWrongPassword
POST http://localhost:8000/auth/login
Content-Type: application/json

{
  "email": "loginte3st@example.com",
  "password": "wrongpassword123"
}

### Alternative login - try with existing user 
# @name loginAlt
POST http://localhost:8000/auth/login
Content-Type: application/json

{
  "email": "test6@example.com",
  "password": "Password123"
}

### Store authentication token for subsequent requests
# Uncomment and use these after successful login
# @authToken = {{login.response.body.accessToken}}
# @refreshToken = {{login.response.body.refreshToken}}

### Refresh token (should provide new tokens)
POST http://localhost:8000/auth/refresh
Content-Type: application/json
Authorization: Bearer YOUR_REFRESH_TOKEN_HERE

### Sign out (requires authentication)
POST http://localhost:8000/auth/signout
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

### Forgot password request
POST http://localhost:8000/auth/forgot-password
Content-Type: application/json

{
  "email": "test@example.com"
}

### Reset password with OTP
POST http://localhost:8000/auth/reset-password
Content-Type: application/json

{
  "email": "test@example.com",
  "otp": "123456",
  "newPassword": "newPassword123"
}

## USER ENDPOINTS
### Create a new user (Password should NOT be returned)
POST http://localhost:8000/users
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Doe",
  "email": "janedoe1223@example.com",
  "password": "SecurePass123",
  "phone": "+1234567890",
  "role": "admin"
}

### Get all users (Passwords should NOT be returned)
GET http://localhost:8000/users

### Get user by ID (Password should NOT be returned)
GET http://localhost:8000/users/1

### Get user by ID with a more recent user
GET http://localhost:8000/users/8

### Update user by ID
PATCH http://localhost:8000/users/1
Content-Type: application/json

{
  "firstName": "Jane Updated",
  "phone": "+9876543210"
}

### Update user password (should NOT return password in response)
PATCH http://localhost:8000/users/1
Content-Type: application/json

{
  "password": "NewSecurePass456"
}


##SUPPORT
### Create a new support ticket
POST http://localhost:8000/support
Content-Type: application/json

{
  "userId": 3,
  "subject": "Unable to make a booking",
  "message": "I'm having trouble booking a vehicle. Please help.",
  "status": "open"
}

###

### Get all support tickets
GET http://localhost:8000/support

###

### Get a support ticket by ID
GET http://localhost:8000/support/1

###

### Update a support ticket by ID
PATCH http://localhost:8000/support/1
Content-Type: application/json

{
  "status": "resolved"
}

###

### Delete a support ticket by ID
DELETE http://localhost:3000/support/1


##BRANCH
### Create a new branch
POST http://localhost:8000/branches
Content-Type: application/json

{
  "name": "Main City Branch",
  "address": "123 Main Street, Springfield",
  "phone": "+1234567890",
  "email": "mainbranch@autohub.com"
}

###

### Get all branches
GET http://localhost:8000/branches

###

### Get a branch by ID
GET http://localhost:8000/branches/1

###

### Update a branch by ID
PATCH http://localhost:8000/branches/1
Content-Type: application/json

{
  "phone": "+1987654321",
  "address": "456 Updated Ave, Newtown"
}

###

### Delete a branch by ID
DELETE http://localhost:3000/branches/1


##VEHICLE SPEC
### Create a new vehicle specification
POST http://localhost:8000/vehicle-specs
Content-Type: application/json

{
  "make": "Toyota",
  "model": "Corolla",
  "year": 2022,
  "seats": 5,
  "transmission": "Automatic",
  "fuelType": "Petrol"
}

###

### Get all vehicle specs
GET http://localhost:8000/vehicle-specs

###

### Get a vehicle spec by ID
GET http://localhost:8000/vehicle-specs/1

###

### Update a vehicle spec by ID
PATCH http://localhost:8000/vehicle-specs/1
Content-Type: application/json

{
  "model": "Corolla Hybrid",
  "fuelType": "Hybrid"
}

###

### Delete a vehicle spec by ID
DELETE http://localhost:3000/vehicle-spec/1



##VEHICLE
### Create a new vehicle
POST http://localhost:8000/vehicle
Content-Type: application/json

{
  "licensePlate": "ABCR-81234",
  "specId": 2,
  "registrationNumber": "REG-5678",
  "branchId": 1,
  "isAvailable": true,
  "fleetId": 1,
  "status": "active",
  "mileage": 12000
}

### Get all vehicles
GET http://localhost:8000/vehicle

### Get a vehicle by ID
GET http://localhost:8000/vehicle/1

### Update a vehicle
PATCH http://localhost:8000/vehicle/2
Content-Type: application/json

{
  "status": "inactive",
  "isAvailable": true,
  "mileage": 13000
}

### Delete a vehicle
DELETE http://localhost:8000/vehicle/1



